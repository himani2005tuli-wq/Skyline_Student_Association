# ─────────────────────────────────────────────────────────────
# BACKEND PRODUCTION ENVIRONMENT VARIABLES
# Set these in your hosting platform (Render / Railway / AWS / VPS)
# ─────────────────────────────────────────────────────────────

# ─── Application ───
NODE_ENV=production
PORT=10000
# URL of your deployed frontend (e.g., https://your-app.vercel.app)
CLIENT_URL=https://your-frontend-domain.vercel.app

# ─── Database (PostgreSQL) ───
# Local Development (Postgres.app or Docker):
# DATABASE_URL=postgresql://sos_user:sos_password@localhost:5432/sos_dev
# DIRECT_URL=postgresql://sos_user:sos_password@localhost:5432/sos_dev
#
# Production (Neon PostgreSQL):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
# DIRECT_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://sos_user:sos_password@localhost:5432/sos_dev
DIRECT_URL=postgresql://sos_user:sos_password@localhost:5432/sos_dev

# ─── Redis ───
# Local Development: redis://localhost:6379
# Production: Upstash rediss://...
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# ─── Authentication & Security ───
# Generate high-entropy 64-character secrets for production: `openssl rand -base64 32`
JWT_SECRET=YOUR_RANDOM_SECURE_JWT_SECRET_STRING_32_CHARS_MIN
JWT_EXPIRES_IN=7d
SESSION_SECRET=YOUR_RANDOM_SECURE_SESSION_SECRET_STRING_32_CHARS_MIN
SESSION_MAX_AGE_MS=86400000
SESSION_IDLE_TIMEOUT_MS=1800000
CSRF_SECRET=YOUR_RANDOM_SECURE_CSRF_SECRET

# Set CORS origin to match your frontend domain (multiple origins can be comma-separated)
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# If your frontend and backend are on different domains (e.g. vercel.app and onrender.com):
SESSION_COOKIE_SAMESITE=none

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
LOGIN_RATE_LIMIT_MAX=10

# ─── Email & Nodemailer SMTP ───
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM_EMAIL=your_email@gmail.com
EMAIL_FROM_NAME="Skyline Student Association"

# ─── Payment Gateway (Razorpay) ───
# Switch to Live keys when ready for real transactions
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
PAYMENT_KEY_SECRET=YOUR_LIVE_KEY_SECRET
PAYMENT_WEBHOOK_SECRET=

# ─── Media Storage (Cloudinary) ───
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# ─── WhatsApp (Meta Cloud API) [Optional] ───
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=YOUR_META_API_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=YOUR_VERIFY_TOKEN
WHATSAPP_APP_SECRET=YOUR_META_APP_SECRET

# ─── Organization & Logging ───
ORG_NAME="Skyline Student Association"
ORG_TIMEZONE=Asia/Kolkata
ORG_CURRENCY=INR
LOG_LEVEL=info
