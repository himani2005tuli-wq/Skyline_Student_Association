{
  "name": "sos-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "@prisma/client": "^6.6.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "cloudinary": "^2.5.0",
    "connect-redis": "^8.0.1",
    "cors": "^2.8.5",
    "csrf-sync": "^4.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "uuid": "^11.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.1.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.6.0",
    "supertest": "^7.1.0",
    "vitest": "^3.1.0"
  }
}
